# Apache-config voor TransIP WebHosting (shared hosting).
#
# Villa 235 is een statische site: de contactknop is een mailto-link, dus er
# is geen server-backend nodig. Deze .htaccess regelt wat Cloudflare Pages
# eerder automatisch deed: HTTPS afdwingen, caching op de gehashte assets,
# security headers en compressie. Een SPA-catch-all is NIET nodig, de hele
# site draait op een enkele pagina op "/".
#
# Gebruik: upload dit bestand in de webroot, naast index.html (dus samen met
# de inhoud van dist/). Vereist mod_rewrite, mod_headers, mod_expires en
# mod_deflate; die staan op TransIP WebHosting standaard aan.

# --- HTTPS afdwingen (proxy-veilig) ----------------------------------
# TransIP forceert HTTPS al op hun proxy; deze regel is een vangnet en checkt
# ook X-Forwarded-Proto, zodat er GEEN redirect-loop ontstaat achter de
# SSL-terminerende proxy (waar %{HTTPS} 'off' kan lezen op een https-verzoek).
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- www -> kaal (canoniek = kaal villa235.com) ----------------------
RewriteCond %{HTTP_HOST} ^www\.villa235\.com$ [NC]
RewriteRule ^ https://villa235.com%{REQUEST_URI} [L,R=301]

# --- Eigen 404-pagina ------------------------------------------------
# Onbekende URL's tonen de 404 in huisstijl (met echte 404-status, geen
# soft-404 redirect naar de homepage).
ErrorDocument 404 /404.html

# --- Cache-Control op de gehashte build-assets -----------------------
# Vite hasht alles onder /assets/ per inhoud, dus een jaar cachen is veilig.
<IfModule mod_expires.c>
  ExpiresActive On
  <FilesMatch "^assets/.*\.(js|css|woff2?)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "^assets/.*\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# --- Cache op foto's en video ----------------------------------------
# Die staan onder /images/ en /video/ en zijn NIET gehasht (kunnen vervangen
# worden), dus korter cachen: een maand.
<IfModule mod_headers.c>
  <FilesMatch "\.(png|jpe?g|webp|svg|mp4|webm)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# --- Security headers ------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# --- Compressie ------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml
</IfModule>
